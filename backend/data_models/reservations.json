{
    "title": "reservations",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "room_id": {
            "type": "string",
            "description": "Room identifier e.g. izba-1"
        },
        "check_in": {
            "type": "string",
            "format": "date",
            "description": "Check-in date YYYY-MM-DD"
        },
        "check_out": {
            "type": "string",
            "format": "date",
            "description": "Check-out date YYYY-MM-DD"
        },
        "guest_name": {
            "type": "string",
            "description": "Guest full name"
        },
        "guest_email": {
            "type": "string",
            "description": "Guest email address"
        },
        "guest_phone": {
            "type": "string",
            "description": "Guest phone number"
        },
        "guests_count": {
            "type": "integer",
            "description": "Number of guests"
        },
        "total_price": {
            "type": "number",
            "description": "Total price in EUR"
        },
        "status": {
            "type": "string",
            "description": "Reservation status: pending, confirmed, cancelled"
        },
        "notes": {
            "type": "string",
            "description": "Additional notes"
        }
    },
    "required": [
        "id",
        "room_id",
        "check_in",
        "check_out",
        "guest_name",
        "guest_email",
        "guests_count",
        "total_price",
        "status"
    ]
}